<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job: run the 24hr Fitness -> Gooni exercise sync once a day at 23:55
  local. If the Mac is asleep at that time, launchd runs the job at next wake.

  Install (paths below assume the repo lives at ~/Desktop/projects/gooni):
    cp scripts/com.gooni.tfhf-sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.gooni.tfhf-sync.plist
  Run once now to test:
    launchctl start com.gooni.tfhf-sync
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.gooni.tfhf-sync.plist

  Secrets are read from the repo .env (TFHF_USERNAME / TFHF_PASSWORD /
  GOONI_AUTH_PASSWORD) -- not hardcoded here. Uses system /usr/bin/python3
  (the script is stdlib-only), so no venv activation is needed.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gooni.tfhf-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/danielgunawan/Desktop/projects/gooni/scripts/sync_24hr_fitness.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/danielgunawan/Desktop/projects/gooni</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>55</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/gooni-tfhf-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/gooni-tfhf-sync.log</string>
</dict>
</plist>
