{
  "manifest_version": 3,
  "name": "Gooni Extension",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "version": "0.1.0",
  "description": "Records which tab actually has focus, buffers locally, and ships intervals to Gooni.",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["tabs", "idle", "storage", "alarms", "favicon"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gooni usage",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "http://localhost:8000/*",
    "https://gooni-bot.fly.dev/*",
    "https://gubith.com/*",
    "https://www.gubith.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_page": "options.html"
}
