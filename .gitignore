# app
app/misc/

# Local AI session state — per-user config, caches, etc. Shared skills
# live under .claude/skills/ and are tracked so they travel with the repo.
.claude/*
!.claude/skills/

# MCP server config — has hardcoded local paths + GOONI_AUTH_PASSWORD secret.
# Per-machine; never share. Use .mcp.json.example as the template.
.mcp.json

# Personal planning / memory dumps — not meant for the public repo.
# DEPLOY_DEBUG.md stays tracked as a useful runbook.
docs/TODO.md
docs/VISION.md
docs/memory_export.json

# Vercel CLI — links local dir to Vercel project (projectId/orgId).
.vercel/

# Eval scorecards — per-run HTML artifacts, accumulate fast. Baselines stay
# tracked (committed JSON = ground truth across PROMPT_VERSION bumps).
evals/reports/

# Eval scratch DB — closed-env replay surface, not real data.
db/gooni-eval.db
db/gooni-eval.db.*

# Eval per-case cache — sha256 of (case + pipeline_model + prompt_version + judge).
# Local artifact, regenerates on demand. Don't commit.
evals/cache/
docs/private/

# Local scratch dir — session notes, audit dumps, throwaway markdown.
.scratch/

# Prod DB snapshot — git-ignored, contains all user data + secrets.
db/gooni-prod-snapshot.db

# Internal handoff notes — local only, never in a public repo.
PORTFOLIO_HANDOFF.md
GOONI_BRIEFING.md
