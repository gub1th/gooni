# Backend API URL — override in production with your Railway/Fly.io URL
# e.g. https://gooni-api.fly.dev
VITE_API_URL=http://localhost:8000

# HTTP Basic Auth — must match AUTH_USERNAME / AUTH_PASSWORD on the backend
# Leave blank in local dev (auth is disabled when AUTH_USERNAME is unset)
VITE_AUTH_USERNAME=
VITE_AUTH_PASSWORD=
