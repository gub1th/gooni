{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "build": {
    "env": {
      "VITE_VERCEL_URL": "$VERCEL_URL",
      "VITE_VERCEL_PROJECT_PRODUCTION_URL": "$VERCEL_PROJECT_PRODUCTION_URL",
      "VITE_VERCEL_GIT_COMMIT_SHA": "$VERCEL_GIT_COMMIT_SHA",
      "VITE_VERCEL_GIT_COMMIT_REF": "$VERCEL_GIT_COMMIT_REF",
      "VITE_VERCEL_GIT_COMMIT_MESSAGE": "$VERCEL_GIT_COMMIT_MESSAGE",
      "VITE_VERCEL_DEPLOYMENT_ID": "$VERCEL_DEPLOYMENT_ID",
      "VITE_VERCEL_ENV": "$VERCEL_ENV"
    }
  }
}
