OPENAI_API_KEY=your_openai_api_key_here

# Database path (defaults to ./db/gooni.db)
# On Railway/Fly.io, set to /data/gooni.db (persistent volume mount point)
DATABASE_URL=sqlite:///./db/gooni.db

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID — find yours by messaging @userinfobot
TELEGRAM_CHAT_ID=

# iMessage via BlueBubbles bridge (https://bluebubbles.app)
# Bridge runs on a Mac with your Apple ID. Leave blank until the Mac is set up;
# the webhook still accepts inbound for local testing in that state.
IMESSAGE_BRIDGE_URL=
IMESSAGE_BRIDGE_PASSWORD=
# Shared secret BlueBubbles sends in X-Secret header on each webhook event.
IMESSAGE_WEBHOOK_SECRET=
# Comma-separated allowlist of inbound handles (phone or Apple ID email).
# Numbers in E.164 form: +15551234567,daniel@me.com
IMESSAGE_ALLOWED_HANDLES=

# WhatsApp via Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
# Get from your Meta app's WhatsApp dashboard.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Random string you pick. Set the same value in Meta's webhook config under
# "Verify Token". Used only for the GET handshake when Meta first registers
# the webhook URL.
WHATSAPP_VERIFY_TOKEN=
# App Secret from Meta dashboard (Settings → Basic). Used to verify the
# X-Hub-Signature-256 header on every inbound POST. Optional in dev (allowlist
# + verify_token still gate everything), required in prod.
WHATSAPP_APP_SECRET=
# Comma-separated allowlist of inbound phone numbers in any format.
# Stored normalized to digits only — `+1 (555) 123-4567` and `15551234567`
# are equivalent.
WHATSAPP_ALLOWED_HANDLES=

# Comma-separated list of allowed frontend origins (no spaces)
# e.g. https://gooni.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# GitHub OAuth (for the Dev Activity dashboard panel)
# Register an OAuth App at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_REDIRECT_URI exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Whoop OAuth (recovery / strain / sleep on the dashboard)
# Register an OAuth client at https://developer.whoop.com
# Redirect URI must match WHOOP_REDIRECT_URI exactly.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/auth/whoop/callback
# Note: webhook signing reuses WHOOP_CLIENT_SECRET above. Whoop does
# not issue a separate webhook secret. Webhook URL is set in the
# "Webhooks" section at the bottom of the app settings page.

TAVILY_API_KEY=
