OPENAI_API_KEY=your_openai_api_key_here

# Database URL (optional, defaults to sqlite)
DATABASE_URL=sqlite:///./db/gooni.db

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID — find yours by messaging @userinfobot
# Used by the scheduler to send proactive check-ins
TELEGRAM_CHAT_ID=
