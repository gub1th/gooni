OPENAI_API_KEY=your_openai_api_key_here

# Database path (defaults to ./db/gooni.db)
# On Railway/Fly.io, set to /data/gooni.db (persistent volume mount point)
DATABASE_URL=sqlite:///./db/gooni.db

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID — find yours by messaging @userinfobot
TELEGRAM_CHAT_ID=

# iMessage via BlueBubbles bridge (https://bluebubbles.app)
# Bridge runs on a Mac with your Apple ID. Leave blank until the Mac is set up;
# the webhook still accepts inbound for local testing in that state.
IMESSAGE_BRIDGE_URL=
IMESSAGE_BRIDGE_PASSWORD=
# Shared secret BlueBubbles sends in X-Secret header on each webhook event.
IMESSAGE_WEBHOOK_SECRET=
# Comma-separated allowlist of inbound handles (phone or Apple ID email).
# Numbers in E.164 form: +15551234567,daniel@me.com
IMESSAGE_ALLOWED_HANDLES=

# Comma-separated list of allowed frontend origins (no spaces)
# e.g. https://gooni.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# GitHub OAuth (for the Dev Activity dashboard panel)
# Register an OAuth App at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_REDIRECT_URI exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
